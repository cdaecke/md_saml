includes:
    - phpstan-baseline.neon

parameters:
  parallel:
      # Don't be overly greedy on machines with more CPU's to be a good neighbor especially on CI
      maximumNumberOfProcesses: 5

  level: 5

  bootstrapFiles:
    - ../../.Build/vendor/autoload.php

  paths:
    - ../../Classes
    - ../../Configuration
    - ../../Tests

  scanDirectories:
    - ../../Classes
    - ../../Configuration
    - ../../Tests

  type_coverage:
      return_type: 80
      param_type: 80
      property_type: 95
