includes:
    - phpstan-baseline.neon

parameters:
  parallel:
      # Don't be overly greedy on machines with more CPU's to be a good neighbor especially on CI
      maximumNumberOfProcesses: 5

  level: 5

  bootstrapFiles:
    - ../../.Build/vendor/autoload.php

  paths:
    - ../../Classes
    - ../../Configuration
    - ../../Tests

  type_coverage:
      return_type: 80
      param_type: 80
      property_type: 95
      # Not enforced: class constants can't be natively typed until PHP 8.3
      # (project supports >=8.2), and the message-text-based baseline entry
      # for this rule breaks every time the project-wide constant count
      # changes anywhere, which makes baselining it a maintenance trap.
      constant_type: 0
